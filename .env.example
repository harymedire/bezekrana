# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Default subscription price IDs per currency (recurring weekly)
STRIPE_PRICE_SUB_BAM=price_...
STRIPE_PRICE_SUB_EUR=price_...
STRIPE_PRICE_SUB_USD=price_...
# Default one-time price IDs per currency (used as fallback if pack has no override)
STRIPE_PRICE_ONETIME_BAM=price_...
STRIPE_PRICE_ONETIME_EUR=price_...
STRIPE_PRICE_ONETIME_USD=price_...

# --- Dodo Payments (PRIVREMENO ISKLJUČENO — Stripe je primarni payment provider) ---
NEXT_PUBLIC_DODO_PUBLISHABLE_KEY=
DODO_SECRET_KEY=
DODO_WEBHOOK_SECRET=
DODO_API_BASE_URL=https://api.dodopayments.com
DODO_PRODUCT_SUB_BAM=
DODO_PRODUCT_SUB_EUR=
DODO_PRODUCT_SUB_USD=
DODO_PRODUCT_ONETIME_BAM=
DODO_PRODUCT_ONETIME_EUR=
DODO_PRODUCT_ONETIME_USD=

# --- Brevo (transactional + marketing email) ---
# Settings → SMTP & API → API Keys → Generate
BREVO_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
